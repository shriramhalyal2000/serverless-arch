{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Effect": "Allow",
            "Action": [
                "s3:GetObjectTagging",
                "s3:HeadObject"
            ],
            "Resource": "arn:aws:s3:::your-source-bucket-name/*"
        },
        {
            "Effect": "Allow",
            "Action": "sns:Publish",
            "Resource": "arn:aws:sns:region:account-id:destination-sns-topic-b"
        }
    ]
}